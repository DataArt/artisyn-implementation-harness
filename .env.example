# AWS credentials (used by aws-mcp and AWS CLI)
# Configure named profiles in ~/.aws/credentials.
# See docs/Engineering Guide/02 Configuration & Secrets.md for full guide.

export AWS_PROFILE=
export AWS_REGION=

# Atlassian MCP credentials (used by mcp-atlassian)
# See .harness-bootstrap/Engineering Guide/05 MCP Setup.md for setup instructions.
#
# Generate your Atlassian API token at: https://id.atlassian.com/manage-profile/security/api-tokens
# Use your Atlassian account email as the username.

export CONFLUENCE_URL=
export CONFLUENCE_USERNAME=
export CONFLUENCE_API_TOKEN=
export CONFLUENCE_SPACES_FILTER=

export JIRA_URL=
export JIRA_USERNAME=
export JIRA_API_TOKEN=
export JIRA_PROJECTS_FILTER=

# GitHub MCP credentials (used by @modelcontextprotocol/server-github)
# Generate a PAT at: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user

export GITHUB_PERSONAL_ACCESS_TOKEN=
