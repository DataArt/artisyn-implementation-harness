# Template for the scaffolded apps/log-hub/.local/.env, copied there by `yarn nx run log-hub:init`
# on first run only. This file documents this design's settled defaults; it is never read by
# Docker Compose directly — only the scaffolded .local/.env is.
#
# LOG_HUB_VERSION is this wrapper's own pinned release, read directly from this committed file
# (not from the scaffolded .local/.env) by `init`/`serve --upgrade` — bumping it here and
# re-running `log-hub:upgrade` is the reviewable way to move to a newer release.
LOG_HUB_VERSION=1.4.1
#
# Lines left empty below are filled in by `log-hub:init` on first run, then never touched again:
#   LOG_HUB_DATA_DIR    -> an absolute path outside this repo tree, derived from the repo's remote
#   POSTGRES_PASSWORD   -> a generated random value
#   SESSION_SECRET      -> a generated random value
# A relative LOG_HUB_DATA_DIR would resolve against this file's own directory (.local/), which is
# inside the repo tree — the opposite of what this design requires, so it must stay absolute.

LOG_HUB_DATA_DIR=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=a-log

SESSION_SECRET=
COOKIE_SECURE=false
TRUST_PROXY=false

# none | password | password-confirm | azure-oauth. `none` (Mode 1) is this design's settled
# choice: loopback-only, single local user, no password. See
# docs/Target Architecture (HLD)/v1/Containers/Log Hub.md.
AUTH_MODE=none

# --- Everything below is optional upstream configuration, left at its documented default. See
#     the release's own env.example for the full reference. ---

#PUBLIC_BASE_URL=https://log-hub.example.com
#ALLOWED_EMAIL_DOMAINS=example.com,example.org
#ADMIN_CONTACT_EMAIL=admin@example.com
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_FROM=no-reply@example.com
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_SECURE=false
#AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
#AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
#AZURE_CLIENT_SECRET=
#AZURE_REDIRECT_URI=http://localhost:5003/api/auth/callback
#AZURE_SCOPES=openid profile email
#AZURE_AUTHORITY=
#AUTH_RATE_LIMIT_POINTS=5
#AUTH_RATE_LIMIT_WINDOW_SEC=900
#IMPORT_MAX_UPLOAD_BYTES=5368709120
#IMPORT_MAX_ENTRIES=20000
#IMPORT_MAX_UNCOMPRESSED_BYTES=21474836480
#IMPORT_MAX_ENTRY_BYTES=419430400
#SESSION_RETENTION_DAYS=30
#SESSION_RETENTION_CHECK_INTERVAL_MS=1800000
#SESSION_RETENTION_PURGE_BATCH_SIZE=200
#LOG_RETENTION_DAYS=5
#SQL_LOG_RETENTION_DAYS=3
#LOG_RETENTION_MAX_MB=100
#LOG_RETENTION_CHECK_INTERVAL_MS=3600000
#BUDGET_CHECK_INTERVAL_MS=300000
#BUDGET_CHECK_ENABLED=true
#AI_TOOL_VERSION_CHECK_ENABLED=true
#AI_TOOL_VERSION_CHECK_INTERVAL_MS=3600000
#MODEL_PRICING_FETCH_ENABLED=true
#MODEL_PRICING_FETCH_INTERVAL_MS=3600000
#LOG_HUB_RELEASE_CHECK_ENABLED=true
#PASSWORD_POLICY=long
#LOGS_MAX_BODY_MB=2500
#UPLOAD_QUEUE_MAX_ATTEMPTS=5
