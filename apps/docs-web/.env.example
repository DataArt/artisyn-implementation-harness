# Deploy config — loaded by NX via envFile. Copy to .env.dev or .env.prod and fill in values.
# See docs/Engineering Guide/Infrastructure/00 Configuration & Secrets.md for full guide.

AWS_REGION=
S3_BUCKET_NAME={org}-{env}-docs-{locationShort}-s3-01
CF_DISTRIBUTION_ID=

# Build-time config — consumed by vitepress build/dev via config.ts and
# GiscusComments.vue. VITE_ prefix required so Vite exposes these to the
# client-side Giscus component (import.meta.env), not just Node-side config.ts.
VITE_GITHUB_ORG=
VITE_GITHUB_REPO=

# Opaque GitHub GraphQL node IDs, unique to this repo's Giscus installation —
# generate at https://giscus.app once Giscus is enabled on the target repo.
VITE_GISCUS_REPO_ID=
VITE_GISCUS_CATEGORY_ID=