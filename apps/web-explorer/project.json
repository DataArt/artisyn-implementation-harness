{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web-explorer",
  "projectType": "application",
  "root": "apps/web-explorer",
  "sourceRoot": "apps/web-explorer/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev --hostname 0.0.0.0",
        "cwd": "apps/web-explorer"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev --hostname 0.0.0.0",
        "cwd": "apps/web-explorer"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "rm -rf .preview && mkdir -p .preview && cp -R out .preview/artisyn-implementation-harness && node scripts/post-export.mjs --resign --origin http://localhost:4173 .preview/artisyn-implementation-harness && node scripts/serve-preview.mjs",
        "cwd": "apps/web-explorer"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next typegen && tsc --noEmit",
        "cwd": "apps/web-explorer"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src scripts e2e playwright.config.ts",
        "cwd": "apps/web-explorer"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test scripts/*.test.mjs src/agent/*.test.ts",
        "cwd": "apps/web-explorer"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/skills/implementation-harness/package.json",
        {
          "env": "NEXT_PUBLIC_REPO_URL"
        },
        {
          "env": "NEXT_PUBLIC_DOCS_URL"
        },
        {
          "env": "NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION"
        },
        {
          "env": "WEBMCP_ORIGIN_TRIAL_TOKEN"
        }
      ],
      "outputs": ["{projectRoot}/out"],
      "options": {
        "command": "NEXT_TELEMETRY_DISABLED=1 next build && node scripts/post-export.mjs && node scripts/check-site.mjs && node scripts/check-bundle-budget.mjs",
        "cwd": "apps/web-explorer"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "install-browsers"],
      "options": {
        "command": "playwright test",
        "cwd": "apps/web-explorer"
      }
    },
    "lighthouse": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "install-browsers"],
      "cache": false,
      "options": {
        "command": "node scripts/lighthouse.mjs",
        "cwd": "apps/web-explorer"
      }
    },
    "install-browsers": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "playwright install --with-deps chromium",
        "cwd": "apps/web-explorer"
      }
    }
  }
}
