# Build config — loaded by NX via envFile. Copy to .env.dev or .env.prod and fill in values.
# See docs/Engineering Guide/Infrastructure/00 Configuration & Secrets.md for full guide.
# SM_SECRET_NAME and AWS_REGION are esbuild --define constants baked into the Lambda bundle at build time.

AWS_REGION=
SM_SECRET_NAME={org}/{env}/docs/lambda-auth
LAMBDA_FUNCTION_NAME={org}-{env}-docs-{locationShort}-fn-01
LAMBDA_ZIP_PATH=apps/lambda-auth/dist/lambda-auth.zip
CF_DISTRIBUTION_ID=
CW_LOG_GROUP=/aws/lambda/{region}.{function-name}