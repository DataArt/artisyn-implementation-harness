# Runtime secrets — pushed to SM via sm-push; pulled via sm-pull.
# Copy to .secrets.dev or .secrets.prod and fill in values.
# Never commit .secrets.dev or .secrets.prod.
# No spaces around = (values are stored verbatim, including any surrounding whitespace).
# Generate: node -e "const{createHash}=require('crypto');console.log(createHash('sha256').update('your-password').digest('hex'))"
DOCS_BASIC_AUTH_HASH=