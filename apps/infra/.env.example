# CDK deployment config — copy to .env.dev or .env.prod and fill in values.
# See docs/Engineering Guide/Infrastructure/00 Configuration & Secrets.md for full guide.

AWS_REGION=
LAMBDA_REGION=us-east-1
ENVIRONMENT=
WORKLOAD=docs
LOCATION_SHORT=
CF_PRICE_CLASS=PriceClass_100

# Short org code used throughout resource names, tags, and SSM parameter paths
# (e.g. "acme"). Must match the ENV_PARAM_NAME prefix in project.json for
# infra/lambda-auth/docs-web — those are static and won't pick this up automatically.
ORG_PREFIX=

# GitHub OIDC trust policy — the repo allowed to assume the CI deploy role.
# Find org/repo numeric IDs at https://api.github.com/repos/{org}/{repo}
GITHUB_ORG=
GITHUB_ORG_ID=
GITHUB_REPO=
GITHUB_REPO_ID=

# The GitHub Actions OIDC provider (token.actions.githubusercontent.com) is an
# AWS-account-wide singleton. Leave true for a fresh, dedicated AWS account (the
# common case). Set to false only if another client/org already provisioned it
# in this same shared account — otherwise CiStack deploy fails with
# EntityAlreadyExistsException.
CREATE_OIDC_PROVIDER=true