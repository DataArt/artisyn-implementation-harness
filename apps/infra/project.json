{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "infra",
  "projectType": "application",
  "root": "apps/infra",
  "sourceRoot": "apps/infra",
  "namedInputs": {
    "default": ["{projectRoot}/**", "sharedGlobals"]
  },
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint bin lib",
        "cwd": "{projectRoot}"
      }
    },
    "synth": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/cdk synth '**'",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": { "envFile": "apps/infra/.env.dev" },
        "prod": { "envFile": "apps/infra/.env.prod" }
      }
    },
    "diff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/cdk diff '**'",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": { "envFile": "apps/infra/.env.dev" },
        "prod": { "envFile": "apps/infra/.env.prod" }
      }
    },
    "output": {
      "executor": "nx:run-commands",
      "options": {
        "command": "aws cloudformation describe-stacks --stack-name DocsStack-$ORG_PREFIX-$WORKLOAD --query 'Stacks[0].Outputs' --output table",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": { "envFile": "apps/infra/.env.dev" },
        "prod": { "envFile": "apps/infra/.env.prod" }
      }
    },
    "output-ci": {
      "executor": "nx:run-commands",
      "options": {
        "command": "aws cloudformation describe-stacks --stack-name CiStack-$ORG_PREFIX-$WORKLOAD --query 'Stacks[0].Outputs' --output table",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": { "envFile": "apps/infra/.env.dev" },
        "prod": { "envFile": "apps/infra/.env.prod" }
      }
    },
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "../../node_modules/.bin/cdk bootstrap",
          "../../node_modules/.bin/cdk bootstrap --region $LAMBDA_REGION"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": { "envFile": "apps/infra/.env.dev" },
        "prod": { "envFile": "apps/infra/.env.prod" }
      }
    },
    "provision": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/cdk deploy '**' --require-approval never",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": { "envFile": "apps/infra/.env.dev" },
        "prod": { "envFile": "apps/infra/.env.prod" }
      }
    },
    "destroy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/cdk destroy '**'",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": { "envFile": "apps/infra/.env.dev" },
        "prod": { "envFile": "apps/infra/.env.prod" }
      }
    },
    "env-push": {
      "configurations": {
        "dev": {
          "env": {
            "ENV_PARAM_NAME": "/artisyn-harness/dev/docs/infra/env",

            "ENV_SOURCE_FILE": "apps/infra/.env.dev"
          }
        },
        "prod": {
          "env": {
            "ENV_PARAM_NAME": "/artisyn-harness/prod/docs/infra/env",

            "ENV_SOURCE_FILE": "apps/infra/.env.prod"
          }
        }
      }
    },
    "env-pull": {
      "configurations": {
        "dev": {
          "env": {
            "ENV_PARAM_NAME": "/artisyn-harness/dev/docs/infra/env",

            "ENV_TARGET_FILE": "apps/infra/.env.dev",
            "ENV_BASE_ENV": "apps/infra/.env.example"
          }
        },
        "prod": {
          "env": {
            "ENV_PARAM_NAME": "/artisyn-harness/prod/docs/infra/env",

            "ENV_TARGET_FILE": "apps/infra/.env.prod",
            "ENV_BASE_ENV": "apps/infra/.env.example"
          }
        }
      }
    },
    "sm-push": {
      "configurations": {
        "dev": {
          "envFile": "apps/infra/.env.dev",
          "env": { "SM_SOURCE_FILE": "apps/infra/.secrets.dev" }
        },
        "prod": {
          "envFile": "apps/infra/.env.prod",
          "env": { "SM_SOURCE_FILE": "apps/infra/.secrets.prod" }
        }
      }
    },
    "sm-pull": {
      "configurations": {
        "dev": {
          "envFile": "apps/infra/.env.dev",
          "env": {
            "SM_TARGET_FILE": "apps/infra/.secrets.dev",
            "SM_BASE_ENV": "apps/infra/.secrets.example"
          }
        },
        "prod": {
          "envFile": "apps/infra/.env.prod",
          "env": {
            "SM_TARGET_FILE": "apps/infra/.secrets.prod",
            "SM_BASE_ENV": "apps/infra/.secrets.example"
          }
        }
      }
    }
  }
}
