{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web-docs",
  "projectType": "application",
  "root": "apps/web-docs",
  "sourceRoot": "apps/web-docs",
  "implicitDependencies": ["docs"],
  "namedInputs": {
    "default": ["{projectRoot}/**", "sharedGlobals"]
  },
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .vitepress",
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "dev",
      "options": {
        "command": "vitepress dev",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": { "envFile": "apps/web-docs/.env.dev" },
        "ci": {},
        "prod": { "envFile": "apps/web-docs/.env.prod" }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "dev",
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/.vitepress/dist"],
      "options": {
        "command": "bash scripts/ci/site-build.sh"
      },
      "configurations": {
        "dev": { "envFile": "apps/web-docs/.env.dev" },
        "ci": {},
        "prod": { "envFile": "apps/web-docs/.env.prod" }
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "vitepress preview",
        "cwd": "{projectRoot}"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "echo \"deploy retired — see solution/Architecture.md in docs/Stories/design/approved/[DESIGN-20261103-LBBI] Migrate Static Site Hosting to GitHub Pages/solution/\" && exit 0"
      }
    },
    "env-push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"env-push retired — see solution/Architecture.md in docs/Stories/design/approved/[DESIGN-20261103-LBBI] Migrate Static Site Hosting to GitHub Pages/solution/\" && exit 0"
      }
    },
    "env-pull": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"env-pull retired — see solution/Architecture.md in docs/Stories/design/approved/[DESIGN-20261103-LBBI] Migrate Static Site Hosting to GitHub Pages/solution/\" && exit 0"
      }
    },
    "sm-push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"sm-push retired — see solution/Architecture.md in docs/Stories/design/approved/[DESIGN-20261103-LBBI] Migrate Static Site Hosting to GitHub Pages/solution/\" && exit 0"
      }
    },
    "sm-pull": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"sm-pull retired — see solution/Architecture.md in docs/Stories/design/approved/[DESIGN-20261103-LBBI] Migrate Static Site Hosting to GitHub Pages/solution/\" && exit 0"
      }
    }
  }
}
