{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.js",
      "{workspaceRoot}/.prettierrc.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true
    },
    "typecheck": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "env-push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/local/env-push.sh"
      }
    },
    "env-pull": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/local/env-pull.sh"
      }
    },
    "sm-push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/local/sm-push.sh"
      }
    },
    "sm-pull": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/local/sm-pull.sh"
      }
    }
  },
  "analytics": false
}
