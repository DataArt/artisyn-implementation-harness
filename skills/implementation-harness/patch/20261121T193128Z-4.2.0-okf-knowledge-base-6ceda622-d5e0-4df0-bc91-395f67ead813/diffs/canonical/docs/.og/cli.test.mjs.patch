+test('golden round-trip: every doc in this repo parses, writes and re-parses to equal values', (t) => {
+  const root = repoRoot();
+  if (!root) return t.skip('not inside the canonical source repo');
+  const rejected = [];
+  let keywordsDocs = 0;
+  let wrapped = 0;
+  const walk = (current) => {
+    for (const entry of fs.readdirSync(current, { withFileTypes: true })) {
+      const full = path.join(current, entry.name);
+      const rel = path.relative(root, full).split(path.sep).join('/');
+      if (entry.isDirectory()) {
+        if (rel !== 'docs/.og') walk(full);
+        continue;
+      }
+      if (!entry.name.endsWith('.md')) continue;
+      const content = fs.readFileSync(full, 'utf8');
+      const first = utils.parseFrontmatter(content);
+      if (first.errors.length) {
+        rejected.push(rel);
+        continue;
+      }
+      if (first.raw === null) continue;
+      const again = utils.parseFrontmatter(utils.writeFrontmatter(first.data) + first.body);
+      assert.deepEqual({ ...again.data }, { ...first.data }, rel);
+      assert.deepEqual(again.errors, [], rel);
+      const keywords = first.data.keywords ?? first.data.tags;
+      if (keywords !== undefined) {
+        keywordsDocs += 1;
+        if (/^(keywords|tags):\s*$/m.test(first.raw)) wrapped += 1;
+        assert.ok(Array.isArray(keywords) && keywords.length > 0, `${rel}: tags parse non-empty`);
+      }
+    }
+  };
+  walk(path.join(root, 'docs'));
+  assert.deepEqual(
+    rejected,
+    ['docs/index.md'],
+    'only the VitePress home uses YAML outside the subset'
+  );
+  assert.ok(keywordsDocs > 0);
+  t.diagnostic(
+    `${keywordsDocs} docs carry tags; ${wrapped} use a wrapped list the old parser read as empty`
+  );
+});
