+// --- AC-9 · Greenfield launch end state (what launch D.6 writes) --------------
+
+/** The docs a greenfield launch writes: B+ concept docs and a versioned index.md per bundle root. */
+function greenfieldLaunch(dir, productDir) {
+  const bplus = (type, title) =>
+    `---\ntype: ${type}\ntitle: ${title}\ndescription: ${title} doc\ntags: [launch]\ngenerated: { by: artisyn-harness/4.2, at: 2026-11-18T10:00:00Z }\nupdated: { by: artisyn-harness/4.2, at: 2026-11-18T10:00:00Z }\n---\n\n# ${title}\n`;
+  const root = (heading, bullets) =>
+    `---\nokf_version: '0.2'\n---\n\n# ${heading}\n\n${bullets.join('\n')}\n`;
+  writeDoc(dir, 'docs/.og/og.config.json', JSON.stringify(productDir ? { productDir } : {}));
+  writeDoc(dir, 'docs/README.md', bplus('Reference', 'Docs'));
+  writeDoc(
+    dir,
+    'docs/Target Architecture (HLD)/README.md',
+    bplus('Version Router', 'HLD Versions')
+  );
+  writeDoc(dir, 'docs/Target Architecture (HLD)/v1/Containers/Web.md', bplus('Container', 'Web'));
+  writeDoc(
+    dir,
+    'docs/Target Architecture (HLD)/index.md',
+    root('Target Architecture', ['- [HLD Versions](README.md) - HLD Versions doc'])
+  );
+  writeDoc(
+    dir,
+    'docs/System Architecture (LLD)/README.md',
+    bplus('Component Registry', 'Registry')
+  );
+  writeDoc(
+    dir,
+    'docs/System Architecture (LLD)/index.md',
+    root('System Architecture', ['- [Registry](README.md) - Registry doc'])
+  );
+  writeDoc(dir, 'docs/Engineering Guide/01 Conventions.md', bplus('Guide', 'Conventions'));
+  writeDoc(
+    dir,
+    'docs/Engineering Guide/index.md',
+    root('Engineering Guide', ['- [Conventions](01%20Conventions.md) - Conventions doc'])
+  );
+  writeDoc(dir, 'docs/Stories/index.md', root('Stories', []));
+  if (productDir) {
+    writeDoc(dir, `${productDir}/00 Overview.md`, bplus('Product Concept', 'Product'));
+    writeDoc(
+      dir,
+      `${productDir}/index.md`,
+      root('Product', ['- [Product Overview](00%20Overview.md) - Product doc'])
+    );
+  }
+  commitAll(dir, 'launch');
+}
+
+for (const productDir of [null, 'docs/Product Context']) {
+  test(`greenfield launch (${productDir ? 'with' : 'without'} a Product folder) is conformant and not pending`, async () => {
+    await withDir(async (dir) => {
+      greenfieldLaunch(dir, productDir);
+      await build({ dir });
+      const report = await og.check({ dir });
+      assert.deepEqual(report.counts, {
+        missingFields: 0,
+        brokenIndexEntries: 0,
+        unlistedConcepts: 0,
+        unversionedBundles: 0,
+        frontmatterErrors: 0,
+      });
+      const roots = fs
+        .readdirSync(path.join(dir, 'docs'), { withFileTypes: true })
+        .filter((entry) => entry.isDirectory() && entry.name !== '.og')
+        .filter(
+          (entry) => fm(path.join(dir, 'docs', entry.name, 'index.md')).okf_version === '0.2'
+        );
+      assert.equal(roots.length, productDir ? 5 : 4);
+      assert.equal((await og.migrate({ dir, check: true })).pending, false);
+    });
+  });
+}
