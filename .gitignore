# Dependencies
node_modules/

# Build outputs
dist/
**/.vitepress/dist/
**/.vitepress/cache/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example
.secrets.*
!.secrets.example

# Log Hub: downloaded release assets, scaffolded .env, and the hook's local marketplace/config —
# never committed; see docs/Target Architecture (HLD)/v1/Containers/Log Hub.md
/apps/log-hub/.local/
/.artisyn/

# Temp files
*.bak
/tmp/

# Retained agent-e2e runs: report.json is kept, the scratch workspaces are not
/apps/harness-bootstrap-e2e/runs/*/fixture*/

# CDK
cdk.out/

# Word lock files
~$*

# macOS
.DS_Store

# Editor
.idea/
*.iml

# Claude Code — personal/local overrides, never shared
.claude/settings.local.json

# NX
.nx/

# Yarn Berry
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Implementation harness runtime state: generated, per-run or per-machine files.
# Everything else under .harness/state/ is committed (index.json, registry.md,
# launch/answers.json, launch/package.json, patch/APPLIED.md).
.harness/state/objects/
.harness/state/launch/runs/
.harness/state/launch/reports/
.harness/state/launch/package.local.json

# Generated by scripts/pack-shim.mjs for the npm tarball and the release ZIP.
skills/implementation-harness/legacy/
.claude/skills/internal-use-skill-plugin-security-review
.claude/skills/deck-design-corporate
