+/**
+ * Forward-migrate a document written before a lifecycle stage existed: append the
+ * missing stage as pending, in lifecycle order. Nothing recorded is changed.
+ */
+function migrateStages(d) {
+  if (!Array.isArray(d.stages)) return;
+  const present = new Set(d.stages.map((s) => s.id));
+  for (const id of STAGES)
+    if (!present.has(id)) d.stages.push({ id, status: 'pending', attempts: [] });
+  d.stages.sort((a, b) => STAGES.indexOf(a.id) - STAGES.indexOf(b.id));
