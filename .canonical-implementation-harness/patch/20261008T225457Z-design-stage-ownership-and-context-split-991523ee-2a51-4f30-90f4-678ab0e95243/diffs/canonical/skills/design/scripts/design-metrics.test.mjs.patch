+test('a sign-off-gated stage cannot complete without a developer-sourced sign-off in its current attempt', (t) => {
+  const f = fixture(t);
+  for (const stage of SIGN_OFF_GATED_STAGES) {
+    f.ok('stage', 'start', '--stage', stage);
+    assert.equal(
+      f.run('stage', 'complete', '--stage', stage).status,
+      1,
+      `${stage} should refuse to complete without a sign-off`
+    );
+    if (stage === 'publish') approval(f, `${stage}-approval`);
+    signoff(f, stage);
+    f.ok('stage', 'complete', '--stage', stage);
+  }
+});
+test('a retried stage needs a fresh sign-off; the old attempt does not carry over', (t) => {
+  const f = fixture(t);
+  finishStage(f, 'frame');
+  f.ok('stage', 'retry', '--stage', 'frame', '--reason', 'scope_change');
+  assert.equal(
+    f.run('stage', 'complete', '--stage', 'frame').status,
+    1,
+    'old attempt sign-off does not carry over'
+  );
+  signoff(f, 'frame');
+  f.ok('stage', 'complete', '--stage', 'frame');
+});
