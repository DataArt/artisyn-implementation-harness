{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dev lifecycle metrics v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "ticket": {
      "type": ["string", "null"]
    },
    "author": {
      "type": ["string", "null"],
      "description": "The developer running this session, e.g. from `git config user.name`. Set once at init; not re-derived per stage/step. Optional, not required: absent on documents written before this field existed, same as `flags`."
    },
    "tracking_started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ticket_created_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ticket_created_source": {
      "type": ["string", "null"]
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "enum": ["from_tracking_start", "partial"]
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "intervals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interval"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "usage_samples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/usage"
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "lead_time_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "cycle_time_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "observed_work_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "observed_wait_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "unclassified_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "human_reported_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "open_work_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "open_wait_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "rework_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "blocked_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "approval_wait_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "failed_checks": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "first_pass_verification_rate": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "input_tokens": {
                  "type": ["number", "null"],
                  "minimum": 0
                },
                "output_tokens": {
                  "type": ["number", "null"],
                  "minimum": 0
                }
              },
              "required": ["input_tokens", "output_tokens"],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "token_coverage": {
          "enum": ["unavailable", "partial"]
        }
      },
      "required": [
        "lead_time_seconds",
        "cycle_time_seconds",
        "observed_work_seconds",
        "observed_wait_seconds",
        "unclassified_seconds",
        "human_reported_seconds",
        "open_work_seconds",
        "open_wait_seconds",
        "rework_seconds",
        "blocked_seconds",
        "approval_wait_seconds",
        "failed_checks",
        "first_pass_verification_rate",
        "as_of",
        "tokens",
        "token_coverage"
      ],
      "additionalProperties": true
    },
    "lifecycle": {
      "const": "dev"
    },
    "quality": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "as_of": {
              "type": "string",
              "format": "date-time"
            },
            "source": {
              "const": "2-report.md"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "findings": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "by_kind": {
                      "type": "object",
                      "properties": {
                        "deviation": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "bug": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "design": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "improve": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "security": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "performance": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "docs": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "deviation",
                        "bug",
                        "design",
                        "improve",
                        "security",
                        "performance",
                        "docs"
                      ],
                      "additionalProperties": false
                    },
                    "by_severity": {
                      "type": "object",
                      "properties": {
                        "critical": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "high": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "medium": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "low": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "info": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": ["critical", "high", "medium", "low", "info"],
                      "additionalProperties": false
                    },
                    "by_classification": {
                      "type": "object",
                      "properties": {
                        "introduced": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "pre-existing": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "ruled-out": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "advisory": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": ["introduced", "pre-existing", "ruled-out", "advisory"],
                      "additionalProperties": false
                    },
                    "by_resolution": {
                      "type": "object",
                      "properties": {
                        "open": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "fixed": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "accepted": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "tech-debt": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "doc-updated": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": ["open", "fixed", "accepted", "tech-debt", "doc-updated"],
                      "additionalProperties": false
                    },
                    "deviations_by_type": {
                      "type": "object",
                      "properties": {
                        "contradiction": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "extension": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "omission": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": ["contradiction", "extension", "omission"],
                      "additionalProperties": false
                    },
                    "pr_review": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "by_kind": {
                          "type": "object",
                          "properties": {
                            "deviation": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "bug": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "design": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "improve": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "security": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "performance": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "docs": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "deviation",
                            "bug",
                            "design",
                            "improve",
                            "security",
                            "performance",
                            "docs"
                          ],
                          "additionalProperties": false
                        },
                        "by_severity": {
                          "type": "object",
                          "properties": {
                            "critical": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "high": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "medium": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "low": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "info": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": ["critical", "high", "medium", "low", "info"],
                          "additionalProperties": false
                        }
                      },
                      "required": ["total", "by_kind", "by_severity"],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "total",
                    "by_kind",
                    "by_severity",
                    "by_classification",
                    "by_resolution",
                    "deviations_by_type",
                    "pr_review"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "tech_debt": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "ticketed": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "unticketed": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": ["total", "ticketed", "unticketed"],
                  "additionalProperties": false
                }
              ]
            },
            "tests": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "written": {
                      "type": ["integer", "null"],
                      "minimum": 0
                    },
                    "passed": {
                      "type": ["integer", "null"],
                      "minimum": 0
                    },
                    "failed": {
                      "type": ["integer", "null"],
                      "minimum": 0
                    },
                    "skipped": {
                      "type": ["integer", "null"],
                      "minimum": 0
                    },
                    "scopes": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": ["written", "passed", "failed", "skipped", "scopes"],
                  "additionalProperties": false
                }
              ]
            },
            "test_runs": {
              "type": "object",
              "properties": {
                "recorded": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "integer",
                  "minimum": 0
                },
                "interrupted": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": ["recorded", "failed", "errors", "interrupted"],
              "additionalProperties": false
            },
            "closure_issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "version",
            "as_of",
            "source",
            "source_sha256",
            "findings",
            "tech_debt",
            "tests",
            "test_runs",
            "closure_issues"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "ticket",
    "tracking_started_at",
    "ticket_created_at",
    "ticket_created_source",
    "started_at",
    "completed_at",
    "coverage",
    "stages",
    "steps",
    "intervals",
    "checks",
    "usage_samples",
    "metrics"
  ],
  "additionalProperties": true,
  "$defs": {
    "attempt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "ended_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "trigger": {
          "enum": ["initial", "verification_failure", "review_feedback", "scope_change", "reopened"]
        },
        "outcome": {
          "enum": [null, "completed", "superseded"]
        }
      },
      "required": ["id", "started_at", "ended_at", "trigger", "outcome"],
      "additionalProperties": true
    },
    "stage": {
      "type": "object",
      "properties": {
        "id": {
          "enum": ["context", "ceremony", "plan", "implement", "test", "document"]
        },
        "status": {
          "enum": ["pending", "active", "waiting", "completed"]
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "enum": ["retried", "rework", "scope_change", "reopened", "failed_check"]
          },
          "description": "Derived, never hand-set: recalculated by `save()` from attempt triggers and check results on every mutation, same as `metrics`. Absent on documents written before this field existed."
        }
      },
      "required": ["id", "status", "attempts"],
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "plan_ref": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": ["pending", "active", "waiting", "completed"]
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "enum": ["retried", "rework", "scope_change", "reopened", "failed_check"]
          },
          "description": "Derived, never hand-set: recalculated by `save()` from attempt triggers and check results on every mutation, same as `metrics`. Absent on documents written before this field existed."
        }
      },
      "required": ["id", "title", "order", "plan_ref", "depends_on", "status", "attempts"],
      "additionalProperties": true
    },
    "interval": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "stage_id": {
              "enum": ["context", "ceremony", "plan", "implement", "test", "document"]
            },
            "stage_attempt_id": {
              "type": "string",
              "minLength": 1
            },
            "step": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "attempt_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["id", "attempt_id"],
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "started_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "ended_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_observed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "kind": {
              "const": "work"
            },
            "activity": {
              "enum": [
                "investigation",
                "planning",
                "implementation",
                "verification",
                "review",
                "documentation"
              ]
            }
          },
          "required": [
            "id",
            "stage_id",
            "stage_attempt_id",
            "step",
            "started_at",
            "ended_at",
            "last_observed_at",
            "kind",
            "activity"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "stage_id": {
              "enum": ["context", "ceremony", "plan", "implement", "test", "document"]
            },
            "stage_attempt_id": {
              "type": "string",
              "minLength": 1
            },
            "step": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "attempt_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["id", "attempt_id"],
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "started_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "ended_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_observed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "kind": {
              "const": "wait"
            },
            "reason": {
              "enum": ["approval", "user_input", "external_dependency", "environment"]
            },
            "detail": {
              "type": ["string", "null"]
            }
          },
          "required": [
            "id",
            "stage_id",
            "stage_attempt_id",
            "step",
            "started_at",
            "ended_at",
            "last_observed_at",
            "kind",
            "reason",
            "detail"
          ],
          "additionalProperties": true
        }
      ]
    },
    "check": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "stage_id": {
          "enum": ["context", "ceremony", "plan", "implement", "test", "document"]
        },
        "stage_attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "attempt_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["id", "attempt_id"],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["build", "test", "lint", "typecheck", "acceptance"]
        },
        "result": {
          "enum": ["running", "passed", "failed", "error", "cancelled", "interrupted"]
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "ended_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "signal": {
          "type": ["string", "null"]
        },
        "last_observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "id",
        "stage_id",
        "stage_attempt_id",
        "step",
        "name",
        "kind",
        "result",
        "started_at",
        "ended_at",
        "source",
        "evidence_ref",
        "exit_code",
        "signal"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "running"
              }
            }
          },
          "then": {
            "required": ["last_observed_at"],
            "properties": {
              "ended_at": {
                "type": "null"
              },
              "source": {
                "const": "command"
              },
              "exit_code": {
                "type": "null"
              },
              "signal": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "ended_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            }
          }
        }
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "sample_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "const": "ticket"
        },
        "measurement": {
          "const": "delta"
        },
        "input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "output_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "required": [
        "sample_id",
        "source",
        "session_id",
        "scope",
        "measurement",
        "input_tokens",
        "output_tokens"
      ],
      "additionalProperties": true
    }
  }
}
