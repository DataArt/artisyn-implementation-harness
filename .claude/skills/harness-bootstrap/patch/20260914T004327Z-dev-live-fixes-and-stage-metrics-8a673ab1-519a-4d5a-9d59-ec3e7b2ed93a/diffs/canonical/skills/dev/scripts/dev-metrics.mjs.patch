+    need(existing.indexOf(markers.end, existing.indexOf(markers.start)) >= 0, 'Unclosed metrics marker');
+    // Splice literal content so titles containing replacement patterns remain intact.
+    return existing.slice(0, existing.indexOf(markers.start)) + sectionText.split(`## ${heading}\n\n`)[1].trimEnd() + existing.slice(existing.indexOf(markers.end, existing.indexOf(markers.start)) + markers.end.length);
+  }
