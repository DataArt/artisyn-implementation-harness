{
  "permissions": {
    "allow": [
      "Bash(yarn:*)",
      "Bash(git mv:*)",
      "Bash(git add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(ln:*)",
      "Bash(mkdir:*)",
      "Bash(cat:*)"
    ],
    "deny": ["Bash(cdk deploy:*)", "Bash(git push:*)", "Bash(yarn nx run infra:provision:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); if echo \"$input\" | jq -r '.tool_input.command // \"\"' | grep -q 'Stories/archive'; then printf '{\"systemMessage\": \"Story archived.\\nIf anything surprised you this ticket, capture it now:\\n\\n  /skill-reflect <your brain-dump>\\n\\nEven one sentence is enough.\"}'; fi",
            "statusMessage": "Checking for reflection prompt..."
          }
        ]
      }
    ]
  }
}
