{
  "name": "@artisyn-harness/root",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "bootstrap:client": "tsx scripts/bootstrap/bootstrap-client.mts",
    "release:harness-bootstrap": "node scripts/release/release-harness-bootstrap.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.13.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "mmdc": "^0.0.1",
    "nx": "^23.0.0",
    "prettier": "^3.0.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "resolutions": {
    "smol-toml": "^1.9.0"
  }
}
